# AtomyBridge Care backend environment template.
# Copy to .env and fill in real values. Never commit .env.

# SQLAlchemy connection string (local Docker default shown)
DATABASE_URL=postgresql+psycopg://atomy:atomy123@localhost:5432/atomybridge

# Optional test database override. If omitted, tests derive
# atomybridge_test from DATABASE_URL and create it automatically.
TEST_DATABASE_URL=postgresql+psycopg://atomy:atomy123@localhost:5432/atomybridge_test

# JWT signing key — use a long random value in production
SECRET_KEY=change-me-in-production

# Gates practitioner self-registration — leave blank to keep registration
# open (default). Set this before any real deployment.
INVITE_CODE=

# Comma-separated production Host header allowlist.
TRUSTED_HOSTS=atomybridge.com,*.atomybridge.com,api.atomybridge.com,backend-fastapi-linv.onrender.com
