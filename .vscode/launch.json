{
    // Debug the AtomyBridge Care Flutter app from the repository root.
    // The vendored Flutter SDK lives in ../flutter; select it in your IDE if
    // your PATH does not already point at a 3.22.3 checkout.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "AtomyBridge Care",
            "cwd": "simtack",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "AtomyBridge Care (profile mode)",
            "cwd": "simtack",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "AtomyBridge Care (release mode)",
            "cwd": "simtack",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
